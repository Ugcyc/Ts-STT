{
  "name": "stt-tauri",
  "private": true,
  "version": "0.3.2",
  "description": "Local Nemotron streaming speech-to-text desktop app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && set \"LIBCLANG_PATH=C:\\Program Files\\LLVM\\bin\" && set \"CARGO_TARGET_DIR=%LOCALAPPDATA%\\stt-tauri-target\" && tauri",
    "tauri:release": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && set \"CARGO_TARGET_DIR=%LOCALAPPDATA%\\stt-tauri-target\" && tauri",
    "build:tauri": "npm run tauri:release build",
    "build:win:nsis": "npm run tauri:release build -- --bundles nsis",
    "build:win:msi": "npm run tauri:release build -- --bundles msi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
